  "private": true,
  "description": "Offline build tooling: geo pipeline, puzzle-schedule generator and Firestore seeder. Nothing here runs at request time.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
