rules_version = '2';

// Mondo Firestore rules — Phase 1 (02-architecture.md §5).
//
// ############################################################################
// # SHARED-PROJECT HAZARD — READ BEFORE DEPLOYING
// #
// # A ruleset is per DATABASE, and deploying REPLACES the whole thing. There is
// # no merge. The project lisecki-dev hosts everything on lisecki.dev, and this
// # file governs its (default) Firestore database in its entirety.
// #
// # So: if any other lisecki.dev app stores data in this same database, running
// # `firebase deploy --only firestore:rules` from this repo will lock that app
// # out completely — the catch-all below denies everything not explicitly
// # allowed. And a rules deploy from that other app will silently delete
// # Mondo's rules in the same way. Last deploy wins.
// #
// # If that is the situation, the options are: keep one shared rules file as the
// # single source of truth for the whole database, or give Mondo its own named
// # Firestore database (which is NOT free — see docs/05-cost.md §1).
// ############################################################################
//
// Default deny, then three narrow allows. Everything score-bearing is written
// by the Admin SDK only (SEC-6): puzzles, attempts, challenges, and later
// groups/*/results and groups/*/standings. Tested in functions/test/rules/,
// negative cases included; keep it that way.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // FR-1.3: 3–24 chars, letters/digits/space/hyphen/underscore, no edge whitespace.
    function validDisplayName(n) {
      return n is string
        && n.size() >= 3 && n.size() <= 24
        && n.trim() == n
        && n.matches('^[\\p{L}\\p{N} _-]+$');
    }

    // Profiles are readable by any signed-in player (leaderboards need names;
    // email is never stored here, FR-1.4). A player may change only their own
    // displayName and locale; counters and streaks are functions-only.
    match /users/{uid} {
      allow read: if signedIn();
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'locale'])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.locale in ['pt-BR', 'en'];
      allow create, delete: if false;                 // functions only (FR-1.2, FR-1.5)
    }

    match /puzzles/{puzzleId}     { allow read, write: if false; }   // SEC-7: never
    match /challenges/{id}        { allow read, write: if false; }
    match /inviteCodes/{code}     { allow read, write: if false; }

    // A player may read their own attempts — by then they already know every
    // guess in it — and nobody else's. Writes only through submitGuess (SEC-6).
    match /attempts/{attemptId} {
      allow read: if signedIn() && attemptId.split('_')[0] == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
