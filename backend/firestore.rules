rules_version = '2';

// Mondo Firestore rules — Phase 2 (02-architecture.md §5).
//
// ############################################################################
// # SHARED-PROJECT HAZARD — READ BEFORE DEPLOYING
// #
// # A ruleset is per DATABASE, and deploying REPLACES the whole thing. There is
// # no merge. The project lisecki-dev hosts everything on lisecki.dev, and this
// # file governs its (default) Firestore database in its entirety.
// #
// # So: if any other lisecki.dev app stores data in this same database, running
// # `firebase deploy --only firestore:rules` from this repo will lock that app
// # out completely — the catch-all below denies everything not explicitly
// # allowed. And a rules deploy from that other app will silently delete
// # Mondo's rules in the same way. Last deploy wins.
// #
// # If that is the situation, the options are: keep one shared rules file as the
// # single source of truth for the whole database, or give Mondo its own named
// # Firestore database (which is NOT free — see docs/05-cost.md §1).
// ############################################################################
//
// Default deny, then a handful of narrow read allows. Everything score-bearing
// or membership-bearing is written by the Admin SDK only (SEC-6): puzzles,
// attempts, challenges, groups and their members, invites. The client never
// even loads the Firestore SDK — every read goes through a callable — so these
// allows are defence in depth, not the access path. Tested in
// functions/test/rules/, negative cases included; keep it that way.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // FR-4.10: membership is the member document itself (D-22).
    function inGroup(gid) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }

    // FR-1.3: 3–24 chars, letters/digits/space/hyphen/underscore, no edge whitespace.
    function validDisplayName(n) {
      return n is string
        && n.size() >= 3 && n.size() <= 24
        && n.trim() == n
        && n.matches('^[\\p{L}\\p{N} _-]+$');
    }

    // A player may read their OWN profile and change only their own displayName
    // and locale; counters, streaks, `role` and `groups` are functions-only
    // (FR-7.1, D-27) — hasOnly() below is what enforces that.
    //
    // Read is deliberately `isSelf`, not `signedIn`. A condition that mentions
    // neither `resource` nor the {uid} wildcard also authorizes a LIST of the
    // whole collection, and `groups` is an array: any signed-in account —
    // including one FR-1.7 bars from playing — could have run
    // `where('groups','array-contains', gid)` and read out a group's entire
    // membership with display names, plus everyone's role. That is exactly what
    // FR-4.10 forbids. Other players' names reach the client only through
    // getLeaderboard, which checks membership first; the client never loads the
    // Firestore SDK at all (site/app/firebase.js takes Auth and Functions only).
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'locale'])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.locale in ['pt-BR', 'en'];
      allow create, delete: if false;                 // functions only (FR-1.2, FR-1.5)
    }

    match /puzzles/{puzzleId}     { allow read, write: if false; }   // SEC-7: never
    match /challenges/{id}        { allow read, write: if false; }
    match /invites/{token}        { allow read, write: if false; }   // resolved only by acceptInvite (D-32)

    // Tournaments (Phase 3, docs/06-tournaments.md §4). `cards` holds the
    // answers and is a sibling of `puzzles` for exactly that reason; the
    // tournament and its rounds are served through callables that check group
    // membership, like getLeaderboard.
    //
    // The catch-all below would already deny all three. They are spelled out
    // because this is where someone will one day want to put brackets on the
    // client, and the next line they would write is
    // `match /groups/{gid}/{document=**} { allow read: if inGroup(gid); }` —
    // which is precisely why none of this lives under `groups` (D-39). Keeping
    // the denials explicit keeps the rules tests honest about them too.
    match /tournaments/{tid} {
      allow read, write: if false;
      match /rounds/{n}           { allow read, write: if false; }
    }
    match /cards/{cardId}         { allow read, write: if false; }   // the answers (SEC-1, D-39)

    // FR-4.10: a group and its members are visible to members only. Writes go
    // through the group callables (SEC-6). No other subcollection exists; the
    // catch-all below denies anything else under a group.
    match /groups/{gid} {
      allow read: if inGroup(gid);
      allow write: if false;
      match /members/{uid} {
        allow read: if inGroup(gid);
        allow write: if false;
      }
    }

    // Attempts are CLOSED, including to the player they belong to (D-51).
    //
    // This used to allow a player to read their own attempt, on the reasoning
    // that "by then they already know every guess in it". That reasoning was
    // wrong, and it defeated D-36 outright: the stored guess carries
    // `bearingDeg` beside `distanceKm`, and an exact distance plus an exact
    // bearing from a guess whose centroid is public solves for the answer's
    // centroid in closed form. A player could submit one guess, fetch
    // `attempts/{uid}_{puzzleId}` over the Firestore REST API with their own ID
    // token — the project id is public in site/app/firebase.js — and name the
    // country. The same held for a tournament card, five answers at a time.
    //
    // "The client never loads the Firestore SDK" is a convention of our own
    // bundle, not a control on anyone else's HTTP client. The rule is the
    // control. Nothing is lost by closing it: every read the game performs goes
    // through a callable that projects through guessView/cardView, which send
    // the 8-point compass and never the degrees.
    match /attempts/{attemptId} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
